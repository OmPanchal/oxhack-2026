{
  "schemaVersion": "forecast-experiment-design-v1",
  "featureProfiles": ["base24", "extended168"],
  "architectures": ["pooled", "per-horizon"],
  "regularization": {
    "original": {
      "objective": "regression_l1", "num_leaves": 7, "max_depth": 3,
      "min_data_in_leaf": 100, "learning_rate": 0.05, "num_boost_round": 120
    },
    "strong": {
      "objective": "regression_l1", "num_leaves": 3, "max_depth": 2,
      "min_data_in_leaf": 200, "learning_rate": 0.03, "num_boost_round": 80,
      "lambda_l1": 5, "lambda_l2": 10
    }
  },
  "correctionWeights": [0, 0.1, 0.25, 0.5, 1],
  "includePerHorizonWeights": true,
  "commonEligibilityLookback": 168,
  "walkForwardFractionsOfOriginalTraining": [0.4, 0.6, 0.8, 1.0],
  "minimumImprovingFolds": 2,
  "absoluteMaeTolerance": 1e-12,
  "confirmationPolicy": "Freeze the OOF winner before comparing on the original, previously inspected validation period; do not rerank by confirmation",
  "protectedPeriods": ["calibration", "test"]
}
