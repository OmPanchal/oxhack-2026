{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadComputePriceHistoryAndHardware",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSpotPriceHistory",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "eu-north-1",
            "eu-west-1",
            "eu-west-2",
            "eu-central-1",
            "eu-west-3",
            "us-east-1",
            "us-east-2",
            "us-west-2",
            "ca-central-1",
            "ap-southeast-1",
            "ap-southeast-2",
            "ap-northeast-1"
          ]
        }
      }
    }
  ]
}
