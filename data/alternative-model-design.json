{
  "schemaVersion": "alternative-price-model-design-v1",
  "featureProfile": "extended168",
  "architecture": "per-horizon",
  "seed": 42,
  "walkForwardFractions": [0.4, 0.6, 0.8, 1.0],
  "minimumImprovingFolds": 2,
  "absoluteMaeTolerance": 1e-12,
  "correctionWeights": [0.5, 1.0],
  "changeThresholds": [0.5, 0.7, 0.9],
  "models": {
    "ridge": {"alpha": 10.0},
    "extra-trees": {"n_estimators": 80, "max_depth": 6, "min_samples_leaf": 30, "max_features": 0.8},
    "hist-gradient": {"loss": "absolute_error", "max_iter": 80, "max_leaf_nodes": 7, "min_samples_leaf": 40, "learning_rate": 0.05, "l2_regularization": 1.0, "early_stopping": false},
    "two-stage": {"num_leaves": 7, "max_depth": 3, "min_data_in_leaf": 60, "learning_rate": 0.05, "num_boost_round": 80, "lambda_l1": 0.5, "lambda_l2": 2.0},
    "lightgbm-reference": {"num_leaves": 3, "max_depth": 2, "min_data_in_leaf": 200, "learning_rate": 0.03, "num_boost_round": 80, "lambda_l1": 5, "lambda_l2": 10}
  },
  "selectionRule": "Lowest aggregate earlier-fold MAE among variants improving at least two folds and aggregate MAE; freeze before later development comparison. Otherwise persistence.",
  "laterPeriodStatus": "Previously inspected development data, not independent confirmation or final test",
  "protectedPeriods": ["calibration", "test"]
}
